# NOVA Environment Configuration Template
# Copy this file to .env and adjust variables as required.

# Google Gemini API Key (Required for live agent model inference)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Runtime Environment (development | test | production)
NOVA_ENV=development

# Model Target (defaults to gemini-3.8-flash)
NOVA_MODEL=gemini-3.8-flash

# Extended Reasoning / Thinking Level (minimal | low | medium | high | extra_high)
NOVA_THINKING_LEVEL=high

# Security Mode (strict | standard | permissive)
# strict: Read-only operations allowed, all write/terminal tools denied
# standard: Read-only allowed, medium-risk tools require interactive approval
# permissive: Read-only and non-destructive tools allowed (not recommended for production)
NOVA_SECURITY_MODE=strict

# Workspace Confinement Root (Path)
# Tools cannot inspect or modify files outside this directory.
NOVA_WORKSPACE_ROOT=.

# Local Data Directory for state, memory, and audit trail
NOVA_DATA_DIR=.nova

# Logging Level (DEBUG | INFO | WARNING | ERROR)
NOVA_LOG_LEVEL=INFO

# Interactive approval requirement for medium risk tools
NOVA_REQUIRE_APPROVAL_FOR_MEDIUM_RISK=true
